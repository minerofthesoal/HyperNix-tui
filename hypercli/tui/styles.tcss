/* OpenClaw-style red/black theme for hypercli */

Screen {
    background: #000000;
    color: #f5f5f5;
}

#header {
    dock: top;
    height: 3;
    background: #000000;
    border-bottom: solid #880022;
    color: #ff2244;
    text-align: center;
    text-style: bold;
}

#footer {
    dock: bottom;
    height: 1;
    background: #0a0a0a;
    color: #ff6688;
    border-top: solid #880022;
}

#sidebar {
    width: 28;
    background: #050505;
    border-right: solid #880022;
    color: #f5f5f5;
    padding: 0 1;
}

#chat {
    background: #000000;
    color: #f5f5f5;
    padding: 0 1;
}

#input {
    dock: bottom;
    height: 3;
    background: #0a0a0a;
    border-top: solid #ff2244;
    color: #ffffff;
    padding: 0 1;
}

Message {
    background: #000000;
    color: #f5f5f5;
    margin: 0 0 1 0;
    padding: 0 1;
}

Message.user {
    border-left: thick #ff2244;
    color: #ffffff;
}

Message.assistant {
    border-left: thick #880022;
    color: #ffeedd;
}

Message.system {
    color: #999999;
    text-style: italic;
}

Message.tool {
    color: #ffaa33;
    border-left: thick #551119;
}

.tool-call {
    color: #ff6688;
    text-style: bold;
}

.tool-result {
    color: #66ddaa;
}

.title-text {
    color: #ff2244;
    text-style: bold;
}

Button {
    background: #880022;
    color: #ffffff;
    border: solid #ff2244;
}

Button:hover {
    background: #ff2244;
}

Input {
    background: #050505;
    color: #ffffff;
    border: solid #880022;
}

Input:focus {
    border: solid #ff2244;
}

Tree {
    background: #050505;
    color: #ff6688;
}
